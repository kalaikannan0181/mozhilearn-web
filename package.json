{
  "name": "mozhi-learn-teacher-portal",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/index.cjs\" \"vite\"",
    "dev:all": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "server": "node server/index.cjs",
    "test": "node --test tests/**/*.test.cjs",
    "dataset:manifest": "node scripts/build-approved-import-manifest.cjs",
    "dataset:dry-run": "node scripts/dry-run-approved-import.cjs",
    "db:migrate": "node server/migrate.cjs",
    "db:status": "node server/db-status.cjs",
    "import:csv": "node server/import.cjs",
    "import:json": "node server/import.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.13.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
